{
	"name": "df_scd_type2_customer",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "srccustomer"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTablescdsource",
						"type": "DatasetReference"
					},
					"name": "srcsql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTablescdsource",
						"type": "DatasetReference"
					},
					"name": "sinkupdateold"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTablescdsource",
						"type": "DatasetReference"
					},
					"name": "sinkinsertnew",
					"description": "adding the new rows to sink"
				}
			],
			"transformations": [
				{
					"name": "lookup1"
				},
				{
					"name": "cscdtype2"
				},
				{
					"name": "dcexpireold",
					"description": "prepares old record for expiry"
				},
				{
					"name": "derivedColumnforNewrecords",
					"description": "updating the new records or insert"
				},
				{
					"name": "dcinsertnew",
					"description": "Insert new column in place of old column"
				},
				{
					"name": "uninsertrows",
					"description": "combine new rrds with inserting updated rcrds"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as integer,",
				"          name as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false) ~> srccustomer",
				"source(output(",
				"          customer_key as integer,",
				"          customer_id as integer,",
				"          name as string,",
				"          city as string,",
				"          start_date as timestamp,",
				"          end_date as timestamp,",
				"          is_current as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT *\\nFROM dim_customer\\nWHERE is_current = 1;\\n\\n',",
				"     format: 'query') ~> srcsql",
				"srccustomer, srcsql lookup(srccustomer@customer_id == srcsql@customer_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 split(isNull(srcsql@customer_id),",
				"     !isNull(srcsql@customer_id) && (srccustomer@name != srcsql@name || srccustomer@city != srcsql@city),",
				"     disjoint: false) ~> cscdtype2@(newrecord, changedrecord, unchangedrecord)",
				"dcinsertnew derive(end_date = currentUTC(),",
				"          is_current = 0) ~> dcexpireold",
				"cscdtype2@newrecord derive(start_date = currentUTC(),",
				"          end_date = toTimestamp('9999-12-31'),",
				"          is_current = 1) ~> derivedColumnforNewrecords",
				"cscdtype2@changedrecord derive(start_date = currentUTC(),",
				"          end_date = toTimestamp('9999-12-31'),",
				"          is_current = 1) ~> dcinsertnew",
				"derivedColumnforNewrecords, dcinsertnew union(byName: true)~> uninsertrows",
				"dcexpireold sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          customer_key as integer,",
				"          customer_id as integer,",
				"          name as string,",
				"          city as string,",
				"          start_date as timestamp,",
				"          end_date as timestamp,",
				"          is_current as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['customer_key'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkupdateold",
				"uninsertrows sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          customer_key as integer,",
				"          customer_id as integer,",
				"          name as string,",
				"          city as string,",
				"          start_date as timestamp,",
				"          end_date as timestamp,",
				"          is_current as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkinsertnew"
			]
		}
	}
}